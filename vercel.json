{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-zod run build && pnpm --filter @workspace/api-server run build",
  "outputDirectory": "public",
  "env": {
    "DATA_DIR": "artifacts/api-server/data"
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/data/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}

